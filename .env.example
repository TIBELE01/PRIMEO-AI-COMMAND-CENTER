# =============================================================================
# Primeo AI Command Center — variables d'environnement
# -----------------------------------------------------------------------------
# Copier ce fichier en `.env` à la racine du dépôt (jamais commité) et renseigner
# les valeurs. En production, ces variables sont définies chez l'hébergeur.
#
# Source de vérité : packages/security/secrets/catalog.ts. Chaque service valide
# au démarrage la présence et le FORMAT des variables qui le concernent, et refuse
# de démarrer si l'une d'elles est invalide (sans jamais afficher sa valeur).
#
# Légende :  [public]  peut être exposée au navigateur
#            [SECRET]  ne doit jamais être exposée ni journalisée
#            Obligatoire : web / api / workers  |  « prod » = obligatoire en production
#
# RÈGLE : aucune clé, aucun jeton, aucun identifiant ne doit être écrit dans le code.
# =============================================================================

# --- Application ---------------------------------------------------------------
# [public] Environnement : development | test | production. Défaut : development
NODE_ENV=development
# [public] Niveau de journalisation (api, workers) : fatal|error|warn|info|debug|trace|silent. Défaut : info
LOG_LEVEL=info
# [public] Adresse de l'interface, autorisée par l'API (CORS). Défaut : http://localhost:3000
APP_URL=http://localhost:3000
# [public] Adresse publique de l'interface, utilisée dans les e-mails. Obligatoire : web (prod)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# [public] Adresse de l'API, utilisée par l'interface. Obligatoire : web (prod)
NEXT_PUBLIC_API_URL=http://localhost:4000
# [public] Adresse d'écoute de l'API (0.0.0.0 en conteneur). Défaut : 127.0.0.1
API_HOST=127.0.0.1
# [public] Port d'écoute de l'API. Défaut : 4000
API_PORT=4000

# --- Supabase (projet DÉDIÉ, distinct de la plateforme immobilière) -------------
# [public] URL du projet (https://<ref>.supabase.co). Obligatoire : web, api
NEXT_PUBLIC_SUPABASE_URL=
# [public] Clé publiable (sb_publishable_…). La RLS s'applique. Obligatoire : web, api
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# [SECRET] Clé secrète (sb_secret_…) : contourne la RLS. API et workers uniquement.
SUPABASE_SECRET_KEY=
# [SECRET] Connexion PostgreSQL directe (postgres://…), pour l'outillage uniquement.
DATABASE_URL=

# --- Chiffrement des secrets ----------------------------------------------------
# [SECRET] Clé maîtresse AES-256 des secrets d'intégration stockés en base.
# 32 octets en base64 — générer avec : openssl rand -base64 32. Obligatoire : api, workers (prod)
SECRETS_ENCRYPTION_KEY=
# [public] Version de la clé maîtresse courante (à incrémenter à chaque rotation). Défaut : 1
SECRETS_ENCRYPTION_KEY_VERSION=1

# --- Fournisseurs d'IA (chaque fournisseur est désactivé si sa clé est absente) --
# [SECRET] Clé OpenAI (sk-…)
OPENAI_API_KEY=
# [SECRET] Clé Anthropic / Claude (sk-ant-…)
ANTHROPIC_API_KEY=
# [SECRET] Clé DeepSeek (sk-…)
DEEPSEEK_API_KEY=

# --- n8n ------------------------------------------------------------------------
# [public] Adresse de l'instance n8n (https://…)
N8N_BASE_URL=
# [SECRET] Clé API n8n (16 caractères minimum)
N8N_API_KEY=
# [SECRET] Secret de signature des webhooks n8n (32 caractères minimum)
N8N_WEBHOOK_SIGNING_SECRET=

# --- Zoho -----------------------------------------------------------------------
# [public] Centre de données : com | eu | in | com.au | jp | ca | sa | com.cn
ZOHO_DATA_CENTER=
# [public] Identifiant du client OAuth
ZOHO_CLIENT_ID=
# [SECRET] Secret du client OAuth
ZOHO_CLIENT_SECRET=
# [SECRET] Jeton de rafraîchissement OAuth
ZOHO_REFRESH_TOKEN=

# --- ElevenLabs -----------------------------------------------------------------
# [SECRET] Clé API ElevenLabs
ELEVENLABS_API_KEY=

# --- Tests ----------------------------------------------------------------------
# [SECRET] PostgreSQL 16+ avec pgvector pour les bases de test jetables
# (ex. postgres://postgres:postgres@127.0.0.1:54322/postgres)
TEST_DATABASE_URL=
