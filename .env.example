# =============================================================================
# Primeo AI Command Center — variables d'environnement
# -----------------------------------------------------------------------------
# Copiez ce fichier en `.env` (jamais commité) et renseignez les valeurs.
# RÈGLE : seules les variables préfixées NEXT_PUBLIC_ sont exposées au
# navigateur. Toutes les autres sont strictement côté serveur / worker.
# Les secrets ne doivent jamais être lus directement par un agent IA : ils sont
# injectés par la couche d'intégrations (packages/integrations).
# =============================================================================

# --- Application ---------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
# URL de l'API (apps/api), utilisée par le frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
# Port d'écoute de l'API (apps/api)
API_PORT=4000

# --- Supabase (projet DÉDIÉ, distinct de la plateforme immobilière) -------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# --- Fournisseurs d'IA -----------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- n8n -------------------------------------------------------------------------
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_SIGNING_SECRET=

# --- Zoho ------------------------------------------------------------------------
ZOHO_DATA_CENTER=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# --- ElevenLabs ------------------------------------------------------------------
ELEVENLABS_API_KEY=
