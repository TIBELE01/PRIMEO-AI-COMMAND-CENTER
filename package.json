{
  "name": "primeo-ai-command-center",
  "version": "0.0.0",
  "private": true,
  "description": "Primeo AI Command Center — siège social numérique de Primeo, piloté par des directeurs IA sous gouvernance humaine.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . && turbo run lint",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:agents": "vitest run tests/agents",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts --trace off",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@primeo/agent-system": "workspace:*",
    "@primeo/ai-engine": "workspace:*",
    "@primeo/integrations": "workspace:*",
    "@primeo/orchestration": "workspace:*",
    "@primeo/security": "workspace:*",
    "@primeo/shared": "workspace:*",
    "@primeo/ui": "workspace:*",
    "@types/node": "22.19.1",
    "eslint": "9.39.5",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
